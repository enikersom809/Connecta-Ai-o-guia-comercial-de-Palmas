{
  "entities": {
    "places": {
      "title": "Places",
      "description": "Commercial listings and establishments",
      "properties": {
        "nome": { "type": "string" },
        "categoria": { "type": "string" },
        "tipo": { "type": "string" },
        "cidade": { "type": "string" },
        "bairro": { "type": "string" },
        "endereco": { "type": "string" },
        "telefone": { "type": "string" },
        "whatsapp": { "type": "string" },
        "descricao": { "type": "string" },
        "imagem": { "type": "string" },
        "galeria": { "type": "array", "items": { "type": "string" } },
        "avaliacao": { "type": "number" },
        "reviewsCount": { "type": "number" },
        "featured": { "type": "boolean" },
        "premium": { "type": "boolean" },
        "apenasBanner": { "type": "boolean" },
        "views": { "type": "number" },
        "expiraEm": { "type": "string" },
        "isOpen": { "type": "boolean" },
        "instagram": { "type": "string" },
        "link": { "type": "string" },
        "linkiFood": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["nome", "categoria", "tipo", "cidade"]
    },
    "jobs": {
      "title": "Jobs",
      "description": "Job vacancies",
      "properties": {
        "titulo": { "type": "string" },
        "empresa": { "type": "string" },
        "cidade": { "type": "string" },
        "bairro": { "type": "string" },
        "tipo": { "type": "string" },
        "salario": { "type": "string" },
        "descricao": { "type": "string" },
        "requisitos": { "type": "array", "items": { "type": "string" } },
        "linkContato": { "type": "string" },
        "expiraEm": { "type": "string" },
        "ativa": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["titulo", "empresa", "cidade"]
    },
    "users": {
      "title": "Users",
      "description": "User profiles and credentials",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "public"] },
        "avatar": { "type": "string" },
        "provider": { "type": "string" },
        "city": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "pushNotifications": {
      "title": "Push Notifications",
      "description": "Device tokens and push alerts history",
      "properties": {
        "token": { "type": "string" },
        "titulo": { "type": "string" },
        "conteudo": { "type": "string" },
        "cidade": { "type": "string" },
        "criadoEm": { "type": "string" },
        "disparadoPor": { "type": "string" },
        "status": { "type": "string" },
        "ativo": { "type": "boolean" }
      }
    }
  },
  "firestore": {
    "/places/{placeId}": {
      "schema": "places",
      "description": "Stores all public commercial establishments and locations"
    },
    "/jobs/{jobId}": {
      "schema": "jobs",
      "description": "Stores job vacancies available in the cities"
    },
    "/users/{userId}": {
      "schema": "users",
      "description": "Stores user account profile information"
    },
    "/push-notifications/{notificationId}": {
      "schema": "pushNotifications",
      "description": "Stores FCM push tokens and dispatched broadcast history"
    }
  }
}
